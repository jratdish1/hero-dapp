# ═══════════════════════════════════════════════════════════════════════
# HERO DAO — Production Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════

# ─── On-Chain Anchor Contract (Condition #4) ─────────────────────────
# Address of the deployed HeroDAOAnchor contract on PulseChain
DAO_ANCHOR_CONTRACT=0x_YOUR_DEPLOYED_CONTRACT_ADDRESS

# PulseChain RPC URL (default: public RPC)
PULSECHAIN_RPC_URL=https://rpc.pulsechain.com

# ─── Executor Configuration (Condition #2) ───────────────────────────
# Type: "eoa" for development, "gnosis_safe" for production
DAO_EXECUTOR_TYPE=gnosis_safe

# Executor address (Gnosis Safe address in production)
DAO_EXECUTOR_ADDRESS=0x_YOUR_GNOSIS_SAFE_ADDRESS

# Only for EOA mode (development) — NEVER use in production
# DAO_EXECUTOR_PRIVATE_KEY=0x_NEVER_PUT_THIS_IN_PRODUCTION

# ─── Gnosis Safe Configuration (Production) ─────────────────────────
DAO_SAFE_TX_SERVICE_URL=https://safe-transaction.pulsechain.com
DAO_SAFE_CHAIN_ID=369
DAO_SAFE_THRESHOLD=2
DAO_SAFE_OWNERS=0xOwner1,0xOwner2,0xOwner3

# ─── Rate Limiting (Condition #1) ────────────────────────────────────
# Max proposals per user per 24 hours (default: 3)
DAO_MAX_PROPOSALS_PER_DAY=3

# ─── General ─────────────────────────────────────────────────────────
NODE_ENV=production

# WalletConnect / Reown Project ID
VITE_WALLETCONNECT_PROJECT_ID=d06186d2e107786d2d182c806941f746
