# /etc/grok-chat/hero-wallet.env — root:grokchat 0640. NEVER commit a real key.
XAI_API_KEY=__set_from_vault_on_host__
GROK_MODEL=grok-4.3
SITE_NAME=hero-wallet
PORT=3313
HOST=127.0.0.1
PROMPT_FILE=prompts/hero-wallet.md
ALLOWED_ORIGINS=https://wallet.herobase.io
GUARD=none
RATE_PER_MIN=6
RATE_PER_HOUR=40
DAILY_CAP=1500
MAX_TOKENS=600
REFUSAL_LOG=/var/log/grok-chat/hero-wallet-refusals.jsonl
