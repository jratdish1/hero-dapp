# /etc/grok-chat/herobase.env — root:grokchat 0640. NEVER commit a real key.
XAI_API_KEY=__set_from_vault_on_host__
GROK_MODEL=grok-4.3
SITE_NAME=herobase
PORT=3312
HOST=127.0.0.1
PROMPT_FILE=prompts/herobase.md
ALLOWED_ORIGINS=https://herobase.io,https://www.herobase.io
GUARD=none
RATE_PER_MIN=6
RATE_PER_HOUR=40
DAILY_CAP=1500
MAX_TOKENS=600
REFUSAL_LOG=/var/log/grok-chat/herobase-refusals.jsonl
